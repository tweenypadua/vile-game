# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of the game, used in share text and on the Story image.
NEXT_PUBLIC_SITE_URL=https://vile.example.com

# Day 1 of the game (Case #1), as YYYY-MM-DD. Must match the seed data.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-24

# TMDB → Settings → API → "API Read Access Token" (the long v4 token)
TMDB_READ_TOKEN=your-tmdb-read-access-token

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=you@example.com

# Random string; Vercel Cron sends it as a Bearer token to /api/cron/daily
CRON_SECRET=change-me

# Optional: Upstash Redis REST credentials for rate limiting across servers.
# Without them, a simple per-server limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
